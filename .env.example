# Copy to `.env` (gitignored, never deployed) and fill in. Server-side only: nothing here
# reaches the browser. On AWS set these as Elastic Beanstalk environment properties instead.

# ElevenLabs text-to-speech for spoken dialogue (server/dialogue/speech.mjs).
ELEVENLABS_API_KEY=
# Each character's voice id is a constant in server/dialogue/voices.mjs.
