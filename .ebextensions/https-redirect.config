# Send every plain-HTTP visitor to HTTPS, at the load balancer.
#
# Elastic Beanstalk's generated template points the port-80 listener at the same target group
# as port 443, so `http://rayobandido.com` would serve the game unencrypted. This replaces that
# listener's default action with a 301 instead: the redirect is answered by the load balancer
# itself, so an insecure request never reaches an instance and never costs a proxy hop.
#
# `AWSEBV2LoadBalancerListener` and `AWSEBV2LoadBalancer` are Beanstalk's own logical names for
# the HTTP:80 listener and the shared ALB. Redeclaring the listener here overrides the
# generated one rather than adding a second — two listeners cannot share a port.
#
# Host, path and query are spelled out rather than left to their defaults, because these exact
# values are the ones verified against the live listener: `/rooms?foo=bar` survives the hop.
# The load balancer writes `:443` into the `Location` either way — it emits the port even when
# asked to inherit it — which browsers and crawlers normalise away.
#
# This does not strand the WebSocket. `matchServerUrl` in `src/net/connection.ts` picks `wss:`
# whenever the page itself came over `https:`, so once the redirect has run the socket opens on
# 443 and never meets this listener — which matters, because a browser's WebSocket client does
# not follow a 301.
Resources:
  AWSEBV2LoadBalancerListener:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      LoadBalancerArn:
        Ref: AWSEBV2LoadBalancer
      Port: 80
      Protocol: HTTP
      DefaultActions:
        - Type: redirect
          RedirectConfig:
            Protocol: HTTPS
            Port: "443"
            Host: "#{host}"
            Path: "/#{path}"
            Query: "#{query}"
            StatusCode: HTTP_301
